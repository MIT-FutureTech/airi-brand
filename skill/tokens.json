{
  "name": "AIRI brand tokens",
  "version": "2.0.0",
  "note": "Source of truth for the AIRI colour, type and spacing system. brand.css and everything in templates/ are generated from this file by dev/build-kit/build.py. BRAND.md explains the same values in prose and must agree with it.",

  "color": {
    "primary": "#A32035",
    "primary-hover": "#8A1B2D",
    "primary-dark": "#5E0E20",
    "primary-light": "#D07886",
    "red-500": "#B8455A",
    "red-300": "#E29CA8",
    "red-tint": "#F8E1E5",
    "red-wash": "#FBF3F4",
    "blue": "#2171B5",
    "blue-dark": "#084594",
    "blue-tint": "#DCE9F4",
    "highlight": "#FFF0B3",
    "text": "#1A1A1A",
    "text-muted": "#666666",
    "gray": "#898A8D",
    "rule": "#CCCCCC",
    "border": "#D9D9D9",
    "fill": "#F3F3F3",
    "background": "#FAFAFA",
    "surface": "#FFFFFF",
    "white": "#FFFFFF",
    "link": "#A32035",
    "link-hover": "#8A1B2D",
    "link-visited": "#5E0E20",
    "focus": "#A32035",
    "good": "#3A8F5C",
    "good-ink": "#17653C",
    "good-tint": "#E3F1EA",
    "partial": "#E8A317",
    "partial-ink": "#8A5A18",
    "partial-tint": "#FCF3E3",
    "info-ink": "#084594"
  },

  "color-dark": {
    "note": "Dark mode overrides, for Claude artifacts and dark tools. Tokens not listed keep their light value. Provisional: computed and contrast-checked, not yet proven in shipped work.",
    "text": "#F2F2F2",
    "text-muted": "#A6A6A6",
    "gray": "#6E6E6E",
    "rule": "#3A3A3A",
    "border": "#3A3A3A",
    "fill": "#242424",
    "background": "#1A1A1A",
    "surface": "#242424",
    "link": "#D07886",
    "link-hover": "#E29CA8",
    "link-visited": "#D07886",
    "focus": "#D07886",
    "red-tint": "#431C22",
    "red-wash": "#2A1B1D",
    "blue-tint": "#1C3245",
    "good-ink": "#89BC9D",
    "good-tint": "#22362A",
    "partial-ink": "#E8A317",
    "partial-tint": "#433519",
    "info-ink": "#6BAED6"
  },

  "data": {
    "highlight": ["#A32035", "#898A8D"],
    "pair": ["#A32035", "#E29CA8"],
    "categorical": [
      {"slot": 1, "name": "blue",   "fill": "#2171B5", "ink": "#084594", "tint": "#E0EBF5", "label": "white", "domain": "Discrimination & toxicity"},
      {"slot": 2, "name": "sky",    "fill": "#6BAED6", "ink": "#084594", "tint": "#EAF4F9", "label": "text",  "domain": "Privacy & security"},
      {"slot": 3, "name": "violet", "fill": "#55399E", "ink": "#55399E", "tint": "#E7E3F1", "label": "white", "domain": "Misinformation", "fill-dark": "#9875DA", "label-dark": "text"},
      {"slot": 4, "name": "pink",   "fill": "#CC6699", "ink": "#A3446F", "tint": "#F8EAF1", "label": "text",  "domain": "Malicious actors & misuse"},
      {"slot": 5, "name": "orange", "fill": "#D4762C", "ink": "#A54A0C", "tint": "#F9ECE1", "label": "text",  "domain": "Human-computer interaction"},
      {"slot": 6, "name": "gold",   "fill": "#D9A531", "ink": "#7F5D00", "tint": "#FAF2E2", "label": "text",  "domain": "Socioeconomic & environmental"},
      {"slot": 7, "name": "teal",   "fill": "#117A66", "ink": "#0B6655", "tint": "#DEEFEB", "label": "white", "domain": "AI system safety, failures & limitations"}
    ],
    "other": {"fill": "#898A8D", "ink": "#666666", "tint": "#F3F3F3"},
    "severity": ["#E29CA8", "#D07886", "#B8455A", "#A32035", "#5E0E20"],
    "severity-none": "#F3F3F3",
    "red-continuous": ["#FBF3F4", "#E29CA8", "#D07886", "#B8455A", "#A32035", "#5E0E20"],
    "blue-sequential": ["#EFF6FF", "#C6DBEF", "#9ECAE1", "#6BAED6", "#4292C6", "#2171B5", "#084594"],
    "blue-5": ["#9ECAE1", "#6BAED6", "#4292C6", "#2171B5", "#084594"],
    "diverging-7": ["#084594", "#4292C6", "#9ECAE1", "#F3F3F3", "#E29CA8", "#B8455A", "#5E0E20"],
    "diverging-5": ["#2171B5", "#9ECAE1", "#F3F3F3", "#E29CA8", "#A32035"],
    "labels": {
      "note": "The colour of a label sitting on each step: text is ink #1A1A1A, white is #FFFFFF. Every pair is at least 4.5:1; build.py --check enforces it. On a continuous scale, labels are ink on values lighter than the first white stop. Label colours on fills do not change in dark mode.",
      "severity": ["text", "text", "white", "white", "white"],
      "red-continuous": ["text", "text", "text", "white", "white", "white"],
      "blue-sequential": ["text", "text", "text", "text", "text", "white", "white"],
      "blue-5": ["text", "text", "text", "white", "white"],
      "diverging-7": ["white", "text", "text", "text", "text", "white", "white"],
      "diverging-5": ["white", "text", "text", "text", "white"]
    },
    "chrome": {
      "text": "#1A1A1A",
      "axis-label": "#666666",
      "axis-line": "#CCCCCC",
      "grid": "#D9D9D9",
      "background": "#FFFFFF",
      "uncertainty": "#D9D9D9",
      "no-data": "#F3F3F3"
    }
  },

  "status": {
    "good":    {"mark": "#3A8F5C", "ink": "#17653C", "tint": "#E3F1EA", "words": "good, yes, held, pass"},
    "partial": {"mark": "#E8A317", "ink": "#8A5A18", "tint": "#FCF3E3", "words": "partial, partly, gap, warning"},
    "poor":    {"mark": "#A32035", "ink": "#A32035", "tint": "#F8E1E5", "words": "poor, no, fail, error"},
    "info":    {"mark": "#2171B5", "ink": "#084594", "tint": "#DCE9F4", "words": "info, note"},
    "none":    {"mark": "#D9D9D9", "ink": "#666666", "tint": "#F3F3F3", "words": "none, not applicable, no data"},
    "grade": {
      "note": "No-red, no-green variant for dense Yes / Partial / No matrices under red chrome.",
      "yes":     {"fill": "#FFFFFF", "border": "#CCCCCC", "text": "#1A1A1A"},
      "partial": {"fill": "#FCF3E3", "border": "#E8A317", "text": "#1A1A1A"},
      "no":      {"fill": "#8A5A18", "border": "#8A5A18", "text": "#FFFFFF"}
    }
  },

  "theme": {
    "note": "The 12 theme slots shared by PowerPoint, Word, Excel, Google Slides and Google Sheets. Charts made in those tools take series colours from accent 1 to 6 in order, which is right only for a one-series (red) or two-series (red, blue) chart. Context grey and the category colours are set by hand; see BRAND.md section 5.",
    "slots": {
      "dark1": "#1A1A1A",
      "light1": "#FFFFFF",
      "dark2": "#666666",
      "light2": "#F3F3F3",
      "accent1": "#A32035",
      "accent2": "#2171B5",
      "accent3": "#D9A531",
      "accent4": "#117A66",
      "accent5": "#CC6699",
      "accent6": "#6BAED6",
      "hyperlink": "#A32035",
      "followed-hyperlink": "#5E0E20"
    },
    "custom-swatches": ["#8A1B2D", "#5E0E20", "#B8455A", "#D07886", "#E29CA8", "#F8E1E5", "#898A8D", "#CCCCCC", "#D9D9D9", "#55399E", "#D4762C", "#E8A317", "#3A8F5C", "#FFF0B3", "#EFF6FF", "#C6DBEF", "#9ECAE1", "#4292C6", "#084594"],
    "google-presets": {"#666666": "dark gray 3", "#CCCCCC": "gray", "#D9D9D9": "light gray 1", "#F3F3F3": "light gray 3"},
    "google-presets-note": "Only these four neutrals are Google presets. Ink #1A1A1A, chart gray #898A8D and background #FAFAFA are custom colours. Google's preset named gray is #CCCCCC, the kit's rule, not the kit's gray."
  },

  "typography": {
    "family": "Figtree, Arial, sans-serif",
    "family-mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "weight": {"regular": 400, "semibold": 600, "bold": 700},
    "weight-note": "600 is for web and apps only. Slides, documents and figures use 400 and 700.",
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.25rem",
      "xl": "1.625rem",
      "2xl": "2.125rem",
      "hero": "2.75rem"
    },
    "line-height": {"tight": 1.25, "normal": 1.5},
    "slides-px-1920": {"cover": 72, "title": 56, "outcome": 36, "body": 28, "small": 22, "legal": 20},
    "slides-pt-960": {"cover": 36, "title": 28, "outcome": 18, "body": 14, "small": 11, "legal": 10},
    "docs-pt": {"title": 24, "subtitle": 14, "h1": 18, "h2": 14, "h3": 12, "body": 11, "caption": 9},
    "figure-pt": {"panel-title": 9.5, "label": 8, "smallest": 7}
  },

  "spacing": {
    "unit": "0.5rem",
    "scale": ["0.25rem", "0.5rem", "1rem", "1.5rem", "2rem", "3rem", "4rem"],
    "slides-px-1920": [8, 16, 24, 48],
    "slides-pt-960": [4, 8, 12, 24],
    "slides-margins-px-1920": {"top": 96, "sides": 128, "bottom": 144},
    "slides-margins-pt-960": {"top": 48, "sides": 64, "bottom": 72}
  },

  "radius": {"sm": "4px", "md": "8px"},

  "not-airi": {
    "note": "Reds that belong to other marks. They stay inside their own logos.",
    "mit-red": "#750014",
    "futuretech-red": "#9A2030"
  },

  "avoid": {
    "note": "Tool defaults that cause drift. Never pick these.",
    "google-toolbar-dark-red": "#980000",
    "google-link-blue": "#1155CC",
    "google-slides-teal-link": "#0097A7",
    "pure-red": "#FF0000"
  },

  "replaced": {
    "note": "Kit 1.x values that no longer exist, and the token that replaces each.",
    "#E0E0E0": "border",
    "#C4606F": "red-500"
  },

  "deprecated": {
    "note": "CSS variable names from kit 1.x. brand.css keeps them as aliases so old code still works. Do not use them in new work. A value that is not a token name is kept as written. The tokens.json keys themselves are gone: color.dark (now color.text), typography.size.3xl, typography.line-height.relaxed, radius.lg and radius.full; scripts that read them must change.",
    "color-dark": "color-text",
    "color-border-strong": "color-rule",
    "color-primary-light-hover": "color-red-500",
    "font-size-3xl": "font-size-2xl",
    "line-height-relaxed": "line-height-normal",
    "radius-lg": "radius-md",
    "radius-full": "9999px"
  }
}
